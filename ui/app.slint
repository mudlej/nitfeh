// The window. Every piece of text shown to the user is an @tr() here; lang/ holds the Arabic for each.

import "../assets/fonts/IBMPlexSansArabic-Regular.ttf";
import "../assets/fonts/IBMPlexSansArabic-Medium.ttf";
import "../assets/fonts/IBMPlexSansArabic-SemiBold.ttf";

import { AboutSlint, Palette } from "std-widgets.slint";
import { MaterialPalette, Icon, ScrollView } from "@material";
import { Shapes, Direction, Motion, ButtonKind, ExpressiveButton, RoundButton, Choice, ConnectedGroup, WavyProgress, Badge, SwitchRow, PathField } from "widgets.slint";
import { Scheme } from "theme.slint";

export { Shapes, Direction }

export enum Stage { setup, working, done }

// Something to tell the user about one file. `kind` picks the sentence: 0 is `detail` as it came from the
// engine, 1 no audio track, 2 the input stopped early, 3 `count` damaged packets were skipped.
export struct Problem {
    name: string,
    kind: int,
    count: int,
    detail: string,
    failed: bool,
}

// Text that begins on the start side of the language.
component Para inherits Text {
    horizontal-alignment: Direction.start;
}

component Label inherits Para {
    color: MaterialPalette.on-surface-variant;
    font-size: 13px;
    font-weight: 600;
}

// Fades and slides in when it becomes the current view.
component View inherits Rectangle {
    in property <bool> current;
    property <float> presence: root.current ? 1 : 0;
    opacity: root.presence;
    visible: root.presence > 0.01;
    y: (1 - root.presence) * 24px;
    animate presence { duration: Motion.normal; easing: Motion.smooth; }
}

// A small card over everything else, which is dimmed; a click outside the card closes it.
component Sheet inherits Rectangle {
    in-out property <bool> open;
    property <float> presence: root.open ? 1 : 0;
    visible: root.presence > 0.01;
    opacity: root.presence;
    background: MaterialPalette.scrim.with-alpha(0.45);
    animate presence { duration: Motion.fast; easing: Motion.smooth; }

    TouchArea {
        clicked => { root.open = false; }
    }

    Rectangle {
        width: min(root.width - 48px, 440px);
        height: content.preferred-height;
        y: (root.height - self.height) / 2 + (1 - root.presence) * 24px;
        border-radius: 32px;
        background: MaterialPalette.surface-container-high;
        TouchArea { }
        content := VerticalLayout {
            padding: 28px;
            spacing: 12px;
            @children
        }
    }
}

// A web address that opens in the browser.
component Link inherits Text {
    callback clicked <=> area.clicked;
    color: MaterialPalette.primary;
    font-weight: 500;
    area := TouchArea {
        mouse-cursor: pointer;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 1px;
        background: area.has-hover ? MaterialPalette.primary : transparent;
    }
}

// The language switch and About, on the end side of the header.
component HeaderButtons {
    // The name of the language the switch leads to, shown as its label on hover.
    in property <string> language;
    in property <string> about;
    callback switch-language();
    callback show-about();

    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 4px;
            if Direction.rtl: RoundButton {
                icon: @image-url("icons/info.svg");
                tooltip: root.about;
                tip-at-end: true;
                container: transparent;
                content: MaterialPalette.on-surface-variant;
                clicked => { root.show-about(); }
            }
            RoundButton {
                icon: @image-url("icons/language.svg");
                tooltip: root.language;
                container: transparent;
                content: MaterialPalette.on-surface-variant;
                clicked => { root.switch-language(); }
            }
            if !Direction.rtl: RoundButton {
                icon: @image-url("icons/info.svg");
                tooltip: root.about;
                tip-at-end: true;
                container: transparent;
                content: MaterialPalette.on-surface-variant;
                clicked => { root.show-about(); }
            }
        }
    }
}

// "Another file" and "another folder", on the end side of the chosen source.
component Picks {
    in property <string> file;
    in property <string> folder;
    callback choose-file();
    callback choose-folder();

    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 4px;
            if Direction.rtl: RoundButton {
                icon: @image-url("icons/folder.svg");
                tooltip: root.folder;
                tip-at-end: true;
                clicked => { root.choose-folder(); }
            }
            RoundButton {
                icon: @image-url("icons/file.svg");
                tooltip: root.file;
                clicked => { root.choose-file(); }
            }
            if !Direction.rtl: RoundButton {
                icon: @image-url("icons/folder.svg");
                tooltip: root.folder;
                tip-at-end: true;
                clicked => { root.choose-folder(); }
            }
        }
    }
}

export component App inherits Window {
    // What was chosen.
    in property <bool> has-source;
    in property <bool> source-is-folder;
    in property <string> source-name;
    in property <string> source-place;
    in property <bool> scanning;
    in property <int> to-convert;
    in property <int> already-done;
    // For a single file that is already converted: the name of its output.
    in property <string> existing-name;
    in property <string> source-size;
    // 0 while unknown.
    in property <int> source-seconds;
    in property <string> scan-problem;
    in property <[string]> preset-sizes;
    in property <bool> sizes-are-totals;

    // How to convert it.
    in-out property <int> preset;
    in-out property <bool> recursive;
    in-out property <bool> include-audio;
    in-out property <string> output;

    // While converting.
    in property <Stage> stage;
    in property <float> progress;
    in property <string> current-name;
    in property <int> current-index;
    in property <int> total-files;
    in property <string> speed;
    // Negative while unknown.
    in property <int> seconds-left: -1;
    in property <bool> reading;
    in property <bool> cancelling;
    in property <float> clock;

    // The result.
    in property <bool> was-cancelled;
    in property <int> converted;
    in property <int> failed;
    in property <string> size-before;
    in property <string> size-after;
    in property <string> share;
    in property <int> elapsed-seconds;
    in property <[Problem]> problems;

    in property <string> version;
    in property <bool> arabic;

    callback choose-file();
    callback choose-folder();
    callback choose-output();
    callback options-changed();
    callback begin();
    // Convert what is already converted: over the old output, or beside it as a copy.
    callback begin-again(overwrite: bool);
    callback cancel();
    callback open-output();
    callback again();
    callback switch-language();
    callback open-link(url: string);

    property <bool> about-open;
    property <bool> confirm-open;
    property <bool> all-done-before: root.to-convert == 0 && root.already-done > 0;
    property <bool> can-start: root.has-source && !root.scanning && root.output != ""
        && (root.to-convert > 0 || root.already-done > 0);

    title: @tr("Nitfeh");
    icon: @image-url("../assets/icon.png");
    preferred-width: 600px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 660px;
    background: MaterialPalette.surface;
    default-font-family: "IBM Plex Sans Arabic";
    default-font-size: 15px;

    init => {
        MaterialPalette.schemes = Scheme.schemes;
    }

    // Overrides the system's light or dark setting.
    public function use-scheme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    pure function span(seconds: int) -> string {
        return seconds < 60 ? @tr("{}s", seconds)
            : seconds < 3600 ? @tr("{}m {}s", floor(seconds / 60), mod(seconds, 60))
            : @tr("{}h {}m", floor(seconds / 3600), floor(mod(seconds, 3600) / 60));
    }

    VerticalLayout {
        padding: 24px;
        padding-top: 20px;
        spacing: 20px;

        HorizontalLayout {
            // Above the views below it: the About label hangs a little past this row.
            z: 1;
            spacing: 12px;
            if Direction.rtl: HeaderButtons {
                language: "English";
                about: @tr("About");
                switch-language => { root.switch-language(); }
                show-about => { root.about-open = true; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                Para {
                    text: @tr("Nitfeh");
                    color: MaterialPalette.on-surface;
                    font-size: 30px;
                    font-weight: 600;
                }
                Para {
                    text: @tr("Small audio from long lectures");
                    color: MaterialPalette.on-surface-variant;
                    font-size: 14px;
                }
            }
            if !Direction.rtl: HeaderButtons {
                language: "العربية";
                about: @tr("About");
                switch-language => { root.switch-language(); }
                show-about => { root.about-open = true; }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            // Choose what to convert and how.
            View {
                current: root.stage == Stage.setup;

                if !root.has-source: Rectangle {
                    border-radius: 32px;
                    background: MaterialPalette.primary-container;
                    VerticalLayout {
                        padding: 28px;
                        spacing: 6px;
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Badge {
                                icon: @image-url("icons/wave.svg");
                                size: 112px;
                            }
                        }
                        Rectangle { height: 16px; }
                        Text {
                            text: @tr("Choose a lecture");
                            color: MaterialPalette.on-primary-container;
                            font-size: 28px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("A video or audio file, or a whole folder of them");
                            color: MaterialPalette.on-primary-container;
                            opacity: 0.8;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 20px; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            if Direction.rtl: ExpressiveButton {
                                text: @tr("Choose folder");
                                icon: @image-url("icons/folder.svg");
                                kind: ButtonKind.tonal;
                                large: true;
                                clicked => { root.choose-folder(); }
                            }
                            ExpressiveButton {
                                text: @tr("Choose file");
                                icon: @image-url("icons/file.svg");
                                large: true;
                                clicked => { root.choose-file(); }
                            }
                            if !Direction.rtl: ExpressiveButton {
                                text: @tr("Choose folder");
                                icon: @image-url("icons/folder.svg");
                                kind: ButtonKind.tonal;
                                large: true;
                                clicked => { root.choose-folder(); }
                            }
                        }
                    }
                }

                if root.has-source: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        border-radius: 32px;
                        background: MaterialPalette.primary-container;
                        HorizontalLayout {
                            padding: 20px;
                            padding-left: Direction.rtl ? 16px : 20px;
                            padding-right: Direction.rtl ? 20px : 16px;
                            spacing: 16px;
                            if !Direction.rtl: VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Badge {
                                    icon: root.source-is-folder ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                    size: 64px;
                                }
                            }
                            if Direction.rtl: Picks {
                                file: @tr("Choose another file");
                                folder: @tr("Choose another folder");
                                choose-file => { root.choose-file(); }
                                choose-folder => { root.choose-folder(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Para {
                                    text: root.source-name;
                                    color: MaterialPalette.on-primary-container;
                                    font-size: 18px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Para {
                                    text: root.source-place;
                                    color: MaterialPalette.on-primary-container;
                                    opacity: 0.7;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Para {
                                    text: root.scan-problem != "" ? root.scan-problem
                                        : root.scanning ? @tr("Looking…")
                                        : root.all-done-before && root.source-is-folder ? @tr("Everything here is already converted")
                                        : root.all-done-before ? @tr("Already converted")
                                        : root.to-convert == 0 && root.source-is-folder ? @tr("No videos here. Subfolders or audio files?")
                                        : root.to-convert == 0 ? @tr("Nothing to convert here")
                                        : root.source-seconds > 0 ? @tr("{n} file · {} · {}" | "{n} files · {} · {}" % root.to-convert, root.source-size, root.span(root.source-seconds))
                                        : @tr("{n} file · {}" | "{n} files · {}" % root.to-convert, root.source-size);
                                    color: root.scan-problem != "" ? MaterialPalette.error : MaterialPalette.on-primary-container;
                                    font-size: 14px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                            }
                            if !Direction.rtl: Picks {
                                file: @tr("Choose another file");
                                folder: @tr("Choose another folder");
                                choose-file => { root.choose-file(); }
                                choose-folder => { root.choose-folder(); }
                            }
                            if Direction.rtl: VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Badge {
                                    icon: root.source-is-folder ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                    size: 64px;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Label { text: @tr("Size"); }
                        ConnectedGroup {
                            selected <=> root.preset;
                            choices: [
                                { title: @tr("Standard"), detail: root.sizes-are-totals ? @tr("about {}", root.preset-sizes[0]) : @tr("{} an hour", root.preset-sizes[0]) },
                                { title: @tr("Small"), detail: root.sizes-are-totals ? @tr("about {}", root.preset-sizes[1]) : @tr("{} an hour", root.preset-sizes[1]) },
                                { title: @tr("Smallest"), detail: root.sizes-are-totals ? @tr("about {}", root.preset-sizes[2]) : @tr("{} an hour", root.preset-sizes[2]) },
                            ];
                            changed => { root.options-changed(); }
                        }
                        Para {
                            text: root.preset == 0 ? @tr("Clear speech. The safe choice.")
                                : root.preset == 1 ? @tr("Smaller. A little rougher on noisy recordings.")
                                : @tr("As small as speech stays clear. Try it on one lecture first.");
                            color: MaterialPalette.on-surface-variant;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    if root.source-is-folder: Rectangle {
                        border-radius: 24px;
                        background: MaterialPalette.surface-container-low;
                        VerticalLayout {
                            padding: 4px;
                            SwitchRow {
                                title: @tr("Include subfolders");
                                detail: @tr("Keeps the same folders in the output");
                                checked <=> root.recursive;
                                toggled => { root.options-changed(); }
                            }
                            SwitchRow {
                                title: @tr("Also convert audio files");
                                detail: @tr("Not only videos");
                                checked <=> root.include-audio;
                                toggled => { root.options-changed(); }
                            }
                        }
                    }

                    PathField {
                        label: @tr("Save to");
                        browse-label: @tr("Change");
                        text <=> root.output;
                        edited => { root.options-changed(); }
                        browse => { root.choose-output(); }
                    }

                    Rectangle { vertical-stretch: 1; }

                    VerticalLayout {
                        spacing: 8px;
                        if root.can-start && root.to-convert > 0 && root.already-done > 0: Text {
                            text: @tr("{n} already converted file will be left alone" | "{n} already converted files will be left alone" % root.already-done);
                            color: MaterialPalette.on-surface-variant;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        ExpressiveButton {
                            text: @tr("Start");
                            icon: @image-url("icons/play.svg");
                            large: true;
                            enabled: root.can-start;
                            clicked => {
                                if root.all-done-before {
                                    root.confirm-open = true;
                                } else {
                                    root.begin();
                                }
                            }
                        }
                    }
                }
            }

            // Converting.
            View {
                current: root.stage == Stage.working;
                VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 32px;
                        background: MaterialPalette.surface-container;
                        VerticalLayout {
                            padding: 32px;
                            spacing: 8px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Badge {
                                    icon: @image-url("icons/wave.svg");
                                    size: 104px;
                                    turning: root.stage == Stage.working;
                                    clock: root.clock;
                                }
                            }
                            Rectangle { height: 8px; }
                            Text {
                                text: root.reading ? @tr("Reading…") : @tr("{}%", round(root.progress * 100));
                                color: MaterialPalette.on-surface;
                                font-size: root.reading ? 36px : 64px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Rectangle { height: 4px; }
                            WavyProgress {
                                progress: root.progress;
                                moving: root.stage == Stage.working && !root.cancelling;
                                clock: root.clock;
                            }
                            Rectangle { height: 4px; }
                            Text {
                                text: root.cancelling ? @tr("Stopping…")
                                    : root.seconds-left >= 0 ? @tr("{} left · {} faster than playing it", root.span(root.seconds-left), root.speed)
                                    : @tr("Working out how long it will take…");
                                color: MaterialPalette.on-surface-variant;
                                font-size: 15px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 24px;
                        background: MaterialPalette.surface-container-low;
                        min-height: 72px;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            alignment: center;
                            spacing: 2px;
                            Label {
                                text: root.total-files > 1 ? @tr("File {} of {}", root.current-index, root.total-files) : @tr("Converting");
                            }
                            Para {
                                text: root.current-name;
                                color: MaterialPalette.on-surface;
                                font-size: 15px;
                                font-weight: 500;
                                overflow: elide;
                            }
                        }
                    }

                    ExpressiveButton {
                        text: @tr("Cancel");
                        icon: @image-url("icons/close.svg");
                        kind: ButtonKind.tonal;
                        large: true;
                        enabled: !root.cancelling;
                        clicked => { root.cancel(); }
                    }
                }
            }

            // The result.
            View {
                current: root.stage == Stage.done;
                VerticalLayout {
                    spacing: 16px;

                    result := Rectangle {
                        border-radius: 32px;
                        background: root.failed > 0 && root.converted == 0 ? MaterialPalette.error-container
                            : root.was-cancelled ? MaterialPalette.surface-container : MaterialPalette.primary-container;
                        property <color> content: root.failed > 0 && root.converted == 0 ? MaterialPalette.on-error-container
                            : root.was-cancelled ? MaterialPalette.on-surface : MaterialPalette.on-primary-container;
                        VerticalLayout {
                            padding: 28px;
                            spacing: 4px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Badge {
                                    icon: root.converted > 0 && !root.was-cancelled ? @image-url("icons/check.svg") : @image-url("icons/alert.svg");
                                    container: root.failed > 0 && root.converted == 0 ? MaterialPalette.error
                                        : root.was-cancelled ? MaterialPalette.outline : MaterialPalette.primary;
                                    content: root.failed > 0 && root.converted == 0 ? MaterialPalette.on-error : MaterialPalette.on-primary;
                                    size: 88px;
                                }
                            }
                            Rectangle { height: 8px; }
                            Text {
                                text: root.was-cancelled ? @tr("Cancelled")
                                    : root.converted == 0 ? @tr("Nothing was converted")
                                    : root.failed > 0 ? @tr("Done, with problems") : @tr("Done");
                                color: result.content;
                                font-size: 28px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            if root.converted > 0: Text {
                                text: @tr("{} is now {}", root.size-before, root.size-after);
                                color: result.content;
                                font-size: 18px;
                                font-weight: 500;
                                horizontal-alignment: center;
                            }
                            if root.converted > 0: Text {
                                text: @tr("{n} file · {} of the original size · took {}" | "{n} files · {} of the original size · took {}" % root.converted, root.share, root.span(root.elapsed-seconds));
                                color: result.content;
                                opacity: 0.8;
                                font-size: 14px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.problems.length > 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 24px;
                        background: MaterialPalette.surface-container-low;
                        clip: true;
                        VerticalLayout {
                            padding: 16px;
                            padding-right: 8px;
                            spacing: 8px;
                            Label {
                                text: root.failed > 0 ? @tr("{n} file could not be converted" | "{n} files could not be converted" % root.failed) : @tr("Worth a look");
                            }
                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    padding-right: 12px;
                                    for problem in root.problems: HorizontalLayout {
                                        spacing: 12px;
                                        if !Direction.rtl: VerticalLayout {
                                            alignment: start;
                                            horizontal-stretch: 0;
                                            padding-top: 2px;
                                            Icon {
                                                source: @image-url("icons/alert.svg");
                                                colorize: problem.failed ? MaterialPalette.error : MaterialPalette.on-surface-variant;
                                                width: 20px;
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 0px;
                                            Para {
                                                text: problem.name;
                                                color: MaterialPalette.on-surface;
                                                font-size: 14px;
                                                font-weight: 500;
                                                overflow: elide;
                                            }
                                            Para {
                                                text: problem.kind == 1 ? @tr("No audio track")
                                                    : problem.kind == 2 ? @tr("The file is damaged or incomplete: converted up to where it stops")
                                                    : problem.kind == 3 ? @tr("{n} damaged piece of audio was skipped" | "{n} damaged pieces of audio were skipped" % problem.count)
                                                    : problem.detail;
                                                color: MaterialPalette.on-surface-variant;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        if Direction.rtl: VerticalLayout {
                                            alignment: start;
                                            horizontal-stretch: 0;
                                            padding-top: 2px;
                                            Icon {
                                                source: @image-url("icons/alert.svg");
                                                colorize: problem.failed ? MaterialPalette.error : MaterialPalette.on-surface-variant;
                                                width: 20px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.problems.length == 0: Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 8px;
                        if Direction.rtl && root.converted > 0: ExpressiveButton {
                            horizontal-stretch: 1;
                            text: @tr("Show the files");
                            icon: @image-url("icons/open.svg");
                            large: true;
                            clicked => { root.open-output(); }
                        }
                        ExpressiveButton {
                            horizontal-stretch: 1;
                            text: @tr("Convert more");
                            icon: Direction.rtl ? @image-url("icons/forward.svg") : @image-url("icons/back.svg");
                            kind: root.converted > 0 ? ButtonKind.tonal : ButtonKind.filled;
                            large: true;
                            clicked => { root.again(); }
                        }
                        if !Direction.rtl && root.converted > 0: ExpressiveButton {
                            horizontal-stretch: 1;
                            text: @tr("Show the files");
                            icon: @image-url("icons/open.svg");
                            large: true;
                            clicked => { root.open-output(); }
                        }
                    }
                }
            }
        }
    }

    // What was chosen is already converted: over it, beside it, or not at all.
    Sheet {
        open <=> root.confirm-open;
        Para {
            text: @tr("Already converted");
            color: MaterialPalette.on-surface;
            font-size: 24px;
            font-weight: 600;
        }
        Para {
            text: root.source-is-folder
                ? @tr("The {n} file here already has its audio in the output folder." | "All {n} files here already have their audio in the output folder." % root.already-done)
                : @tr("“\u{2068}{}\u{2069}” is already there.", root.existing-name);
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }
        Para {
            text: @tr("Overwrite replaces what is there. A copy is saved beside it with a number, like “name (2).opus”.");
            color: MaterialPalette.on-surface-variant;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { height: 4px; }
        HorizontalLayout {
            alignment: Direction.rtl ? start : end;
            spacing: 8px;
            if !Direction.rtl: ExpressiveButton {
                text: @tr("Cancel");
                kind: ButtonKind.text;
                compact: true;
                clicked => { root.confirm-open = false; }
            }
            if Direction.rtl: ExpressiveButton {
                text: @tr("Make a copy");
                compact: true;
                clicked => {
                    root.confirm-open = false;
                    root.begin-again(false);
                }
            }
            ExpressiveButton {
                text: @tr("Overwrite");
                kind: ButtonKind.tonal;
                compact: true;
                clicked => {
                    root.confirm-open = false;
                    root.begin-again(true);
                }
            }
            if !Direction.rtl: ExpressiveButton {
                text: @tr("Make a copy");
                compact: true;
                clicked => {
                    root.confirm-open = false;
                    root.begin-again(false);
                }
            }
            if Direction.rtl: ExpressiveButton {
                text: @tr("Cancel");
                kind: ButtonKind.text;
                compact: true;
                clicked => { root.confirm-open = false; }
            }
        }
    }

    Sheet {
        open <=> root.about-open;
        VerticalLayout {
            spacing: 2px;
            Para {
                text: @tr("Nitfeh {}", root.version);
                color: MaterialPalette.on-surface;
                font-size: 24px;
                font-weight: 600;
            }
            Para {
                text: @tr("Small audio from long lectures");
                color: MaterialPalette.on-surface-variant;
            }
        }
        VerticalLayout {
            spacing: 2px;
            Para {
                text: @tr("Made by Mudlej");
                color: MaterialPalette.on-surface;
                font-weight: 500;
            }
            HorizontalLayout {
                alignment: Direction.rtl ? end : start;
                spacing: 8px;
                Link {
                    text: "mudlej.com";
                    clicked => { root.open-link("https://mudlej.com"); }
                }
                Text {
                    text: "·";
                    color: MaterialPalette.on-surface-variant;
                }
                Link {
                    text: "github.com/mudlej/nitfeh";
                    clicked => { root.open-link("https://github.com/mudlej/nitfeh"); }
                }
            }
        }
        Para {
            text: @tr("Free software under the GNU General Public License, version 3 or later.");
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }
        Para {
            text: @tr("Built with FFmpeg (LGPL 2.1 or later), libopus (BSD), Slint and its Material components, IBM Plex Sans Arabic (SIL Open Font License) and Google's Material Symbols (Apache 2.0).");
            color: MaterialPalette.on-surface-variant;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: Direction.rtl ? end : start;
            AboutSlint {
                width: 150px;
                height: 112px;
            }
        }
        HorizontalLayout {
            alignment: Direction.rtl ? start : end;
            ExpressiveButton {
                text: @tr("Close");
                kind: ButtonKind.tonal;
                clicked => { root.about-open = false; }
            }
        }
    }
}
